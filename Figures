)

#------------------------------------------------------------
# Build dose-response curves
#------------------------------------------------------------
build_abx_curve <- function(beta_draws, days_grid) {
  map_dfr(days_grid, function(d) {
    hr <- exp(beta_draws * log1p(d))
    
    tibble(
      days = d,
      median = median(hr),
      lo = quantile(hr, 0.025),
      hi = quantile(hr, 0.975)
    )
  })
}

days_grid <- seq(0, 30, by = 1)

high_curve <- build_abx_curve(draws$beta_abx_high_01, days_grid)
low_curve  <- build_abx_curve(draws$beta_abx_low_01,  days_grid)

##Add interaction with colonisation pressure (important!)
build_high_cp_curve <- function(beta_high, beta_int, cp, days_grid) {
  map_dfr(days_grid, function(d) {
    hr <- exp((beta_high + cp * beta_int) * log1p(d))
    
    tibble(
      days = d,
      median = median(hr),
      lo = quantile(hr, 0.025),
      hi = quantile(hr, 0.975),
      cp = paste0("CP=", cp)
    )
  })
}

