    labs(
      title = title,
      x = NULL,
      y = xlab
    ) +
    theme_minimal(base_size = 12) +
    theme(
      legend.position = "none",
      strip.text = element_text(face = "bold", size = 14),
      axis.title.y = element_text(size = 14),
      axis.text.y = element_blank(),
      axis.ticks.y = element_blank(),
