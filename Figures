                                    parameter_choice,
                                    site_order = NULL,
                                    title = NULL,
                                    xlab = "Incidence per person-month",
                                    fill_value = "#CB181D") {
  df <- draw_df %>%
    filter(site != "Overall", parameter == parameter_choice) %>%
    mutate(site = if (is.null(site_order)) factor(site) else factor(site, levels = site_order))
  
  ann <- summ_df %>%
    filter(site != "Overall", parameter == parameter_choice) %>%
    mutate(
      site = if (is.null(site_order)) factor(site) else factor(site, levels = site_order),
      label = if (parameter_choice == "Mean decolonisation time (days)") {
        sprintf("%.1f (%.1f–%.1f)", median, lo, hi)
      } else {
        sprintf("%.2f (%.2f–%.2f)", median, lo, hi)
      },
      x_pos = if (parameter_choice == "Mean decolonisation time (days)") {
        hi * 1.12
      } else {
