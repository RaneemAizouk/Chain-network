  ggplot(df, aes(x = parameter, y = value)) +
    geom_boxplot(outlier.shape = NA, width = 0.62, linewidth = 0.4, fill = fill_value) +
    geom_text(
      data = ann,
      aes(x = parameter, y = x_pos, label = label),
