plot_seasonality_curve_sites <- function(
    fit,
    pars = c("seasonal_amplitude_site", "seasonal_phase_site"),
    year = 2024,
    normalize_to_year_median = TRUE,
    title = "Estimated Seasonal Variation in ESBL-E Acquisition Risk",
    subtitle = "Site-specific sinusoidal model (median HR with 95% CrI)",
    ylab = "Hazard ratio (reference = yearly median)",
    base_size = 10
) {
  
  site_labels <- c(
    "Kilifi (1)",
    "Migori (2)",
    "Nairobi (3)"
  )
  
  # --- SITE-SPECIFIC RAINY SEASONS ---
  rainy <- tibble::tibble(
    Site = factor(rep(1:3, each = 2), levels = 1:3, labels = site_labels),
    start = as.Date(c(
      paste0(year, "-04-01"), paste0(year, "-11-01"),  # Kilifi
      paste0(year, "-03-01"), paste0(year, "-10-01"),  # Migori
      paste0(year, "-03-25"), paste0(year, "-11-01")   # Nairobi
    )),
    end = as.Date(c(
      paste0(year, "-06-10"), paste0(year, "-12-31"),  # Kilifi
      paste0(year, "-05-31"), paste0(year, "-12-31"),  # Migori
      paste0(year, "-05-31"), paste0(year, "-12-31")   # Nairobi
    ))
  )
  
  draws <- rstan::extract(fit, pars = pars)
  
  a1_mat  <- draws[[pars[1]]]
  phi_mat <- draws[[pars[2]]]
  
  n_sites <- ncol(a1_mat)
  
  dates <- seq.Date(
    as.Date(paste0(year, "-01-01")),
    as.Date(paste0(year, "-12-31")),
    by = "day"
  )
  x <- as.numeric(format(dates, "%j")) / 365.25
  
  season_list <- vector("list", n_sites)
  label_list  <- vector("list", n_sites)
  
  for (s in seq_len(n_sites)) {
    
    site_name <- site_labels[s]
    
    a1  <- a1_mat[, s]
    phi <- phi_mat[, s]
    
    daily_hr <- sapply(seq_along(a1), function(i) {
      exp(a1[i] * sin(2 * pi * x + phi[i]))
    })
    
    if (normalize_to_year_median) {
      daily_hr <- sweep(daily_hr, 2, apply(daily_hr, 2, median), "/")
    }
    
    season_df <- tibble(
      Site  = factor(site_name, levels = site_labels),
      Date  = dates,
      q_low = apply(daily_hr, 1, quantile, probs = 0.025),
      q50   = apply(daily_hr, 1, median),
      q_hi  = apply(daily_hr, 1, quantile, probs = 0.975)
    )
    
    # --- peak/trough logic unchanged ---
    peak_idx   <- which.max(season_df$q50)
    trough_idx <- which.min(season_df$q50)
    
    peak_date   <- season_df$Date[peak_idx]
    trough_date <- season_df$Date[trough_idx]
    
    peak_hr   <- season_df$q50[peak_idx]
    peak_lwr  <- season_df$q_low[peak_idx]
    peak_upr  <- season_df$q_hi[peak_idx]
    
    trough_hr  <- season_df$q50[trough_idx]
    trough_lwr <- season_df$q_low[trough_idx]
    trough_upr <- season_df$q_hi[trough_idx]
    
    ymin <- min(season_df$q_low)
    ymax <- max(season_df$q_hi)
    pad  <- 0.12 * (ymax - ymin)
    
    lower_limit <- max(0, ymin - pad)
    upper_limit <- ymax + pad
    y_span <- upper_limit - lower_limit
    
    peak_y   <- min(upper_limit - 0.05 * y_span, peak_upr + 0.01 * y_span)
    trough_y <- max(lower_limit + 0.07 * y_span, trough_lwr - 0.01 * y_span)
    
    season_list[[s]] <- season_df
    
    label_list[[s]] <- tibble(
      Site = factor(site_name, levels = site_labels),
      peak_date = peak_date,
      trough_date = trough_date,
      peak_y = peak_y,
      trough_y = trough_y,
      peak_hr = peak_hr,
      peak_lwr = peak_lwr,
      peak_upr = peak_upr,
      trough_hr = trough_hr,
      trough_lwr = trough_lwr,
      trough_upr = trough_upr
    )
  }
  
  season_df <- dplyr::bind_rows(season_list)
  label_df  <- dplyr::bind_rows(label_list)
  
  p <- ggplot(season_df, aes(x = Date, y = q50)) +
    
    # --- site-specific rainy shading ---
    geom_rect(
      data = rainy,
      aes(xmin = start, xmax = end, ymin = -Inf, ymax = Inf),
      inherit.aes = FALSE,
      fill = "forestgreen",
      alpha = 0.12
    ) +
    
    geom_ribbon(aes(ymin = q_low, ymax = q_hi), fill = "coral2", alpha = 0.25) +
    geom_line(linewidth = 1.0, color = "coral2") +
    geom_hline(yintercept = 1, linetype = "dashed") +
    
    geom_vline(data = label_df, aes(xintercept = peak_date),
               linetype = "dotdash", col = "darkred", alpha = 0.7) +
    geom_vline(data = label_df, aes(xintercept = trough_date),
               linetype = "dotdash", col = "darkred", alpha = 0.7) +
    
    geom_label(
      data = label_df,
      aes(x = peak_date, y = peak_y,
         # label = sprintf("Peak: %s\nHR %.2f [%.2f–%.2f]",
          #                format(peak_date, "%b"), peak_hr, peak_lwr, peak_upr)),
          label = sprintf("HR %.2f [%.2f–%.2f]",
                          peak_hr, peak_lwr, peak_upr)),
      label.size = 0, size = base_size / 3.2
    ) +
    
    geom_label(
      data = label_df,
      aes(x = trough_date, y = trough_y,
          #label = sprintf("Trough: %s\nHR %.2f [%.2f–%.2f]",
          #                format(trough_date, "%b"), trough_hr, trough_lwr, trough_upr)),
          label = sprintf("HR %.2f [%.2f–%.2f]",
                          trough_hr, trough_lwr, trough_upr)),
      label.size = 0, size = base_size / 3.2
    ) +
    
    facet_wrap(~Site, ncol = 1) +
    
    scale_x_date(date_breaks = "1 month", date_labels = "%b") +
    
    labs(
      title = NULL,
      subtitle = NULL,
      x = "Calendar month",
      y = ylab
    ) +
    
    theme_minimal(base_size = base_size) +
    theme(strip.text = element_text(face = "bold", size = base_size * 1.3),
          axis.text.x = element_text(size = base_size * 1.2),
          axis.text.y = element_text(size = base_size * 1.2),
          
          axis.title.x = element_text(size = base_size * 1.4),
          axis.title.y = element_text(size = base_size * 1.4))
  
  list(data = season_df, plot = p)
}

