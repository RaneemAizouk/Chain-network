#######################################################
#Seasonality over all no random effect for seasonality
#######################################################
plot_seasonality_curve <- function(
    fit,
    site = 1,
    pars = c("seasonal_amplitude_site", "seasonal_phase_site"),
    year = 2024,
    rainy = tibble(
      start = as.Date(paste0(year, "-06-01")),
      end   = as.Date(paste0(year, "-10-31"))
    ),
    normalize_to_year_median = TRUE,
    title = "Estimated Seasonal Variation in ESBL-E Acquisition Risk",
    subtitle = NULL,
    ylab = "Hazard ratio (reference = yearly median)",
    base_size = 12
) {
  draws <- rstan::extract(fit, pars = pars)
  
  if (!all(pars %in% names(draws))) {
    stop("Could not find all requested parameters in the fit: ",
         paste(pars, collapse = ", "))
  }
  
  a1  <- draws[[pars[1]]][, site]
  phi <- draws[[pars[2]]][, site]
  
  dates <- seq.Date(
    as.Date(paste0(year, "-01-01")),
    as.Date(paste0(year, "-12-31")),
    by = "day"
  )
  
  x <- as.numeric(format(dates, "%j")) / 365.25
  
  daily_hr <- sapply(seq_along(a1), function(i) {
    exp(a1[i] * sin(2 * pi * x + phi[i]))
  })
  
  if (normalize_to_year_median) {
    daily_hr <- sweep(daily_hr, 2, apply(daily_hr, 2, median), "/")
  }
  
  season_df <- tibble(
    Date  = dates,
    q_low = apply(daily_hr, 1, quantile, probs = 0.025, na.rm = TRUE),
    q50   = apply(daily_hr, 1, median, na.rm = TRUE),
    q_hi  = apply(daily_hr, 1, quantile, probs = 0.975, na.rm = TRUE)
  )
  
  peak_idx   <- which.max(season_df$q50)
  trough_idx <- which.min(season_df$q50)
  
  peak_date   <- season_df$Date[peak_idx]
  trough_date <- season_df$Date[trough_idx]
  
  peak_hr   <- season_df$q50[peak_idx]
  peak_lwr  <- season_df$q_low[peak_idx]
  peak_upr  <- season_df$q_hi[peak_idx]
  
  trough_hr  <- season_df$q50[trough_idx]
  trough_lwr <- season_df$q_low[trough_idx]
  trough_upr <- season_df$q_hi[trough_idx]
  
  ymin <- min(season_df$q_low, na.rm = TRUE)
  ymax <- max(season_df$q_hi, na.rm = TRUE)
  pad  <- 0.12 * (ymax - ymin)
  
  lower_limit <- max(0, ymin - pad)
  upper_limit <- ymax + pad
  
  y_span <- upper_limit - lower_limit
  peak_y  <- min(upper_limit - 0.05 * y_span, peak_upr + 0.04 * y_span)
  trough_y <- max(lower_limit + 0.07 * y_span, trough_lwr - 0.04 * y_span)
  
  if (is.null(subtitle)) {
    subtitle <- paste0("Site ", site, " sinusoidal model (median HR with 95% CrI)")
  }
  
  p <- ggplot(season_df, aes(x = Date, y = q50)) +
    { if (!is.null(rainy) && nrow(rainy) > 0)
      geom_rect(
        data = rainy,
        aes(xmin = start, xmax = end, ymin = -Inf, ymax = Inf),
        inherit.aes = FALSE,
        fill = "forestgreen",
        alpha = 0.12
      )
    } +
    geom_ribbon(aes(ymin = q_low, ymax = q_hi), fill = "coral2", alpha = 0.25) +
    geom_line(linewidth = 1.2, color = "coral2") +
    geom_hline(yintercept = 1, linetype = "dashed", linewidth = 0.8) +
    geom_vline(xintercept = peak_date, linetype = "dotdash",
               col = "darkred", linewidth = 0.8, alpha = 0.7) +
    geom_vline(xintercept = trough_date, linetype = "dotdash",
               col = "darkred", linewidth = 0.8, alpha = 0.7) +
    annotate(
      "label",
      x = peak_date, y = peak_y,
      label = sprintf(
        "HR = %.2f [%.2f–%.2f]",
        format(peak_date, "%b"), peak_hr, peak_lwr, peak_upr
      ),
      vjust = 0, hjust = 0.5,
      label.size = 0, alpha = 0.95,
      color = "black", size = base_size / 3.2
    ) +
    annotate(
      "label",
      x = trough_date, y = trough_y,
      label = sprintf(
        "HR = %.2f [%.2f–%.2f]",
        format(trough_date, "%b"), trough_hr, trough_lwr, trough_upr
      ),
      vjust = 1, hjust = 0.5,
      label.size = 0, alpha = 0.95,
      color = "black", size = base_size / 3.2
    ) +
    { if (!is.null(rainy) && nrow(rainy) > 0)
      annotate(
        "text",
        x = min(rainy$start),
        y = lower_limit + 0.06 * y_span,
        label = "Rainy season",
        color = "darkgreen",
        fontface = "bold",
        hjust = 0,
        size = base_size / 3.2
      )
    } +
    scale_x_date(date_breaks = "1 month", date_labels = "%b", expand = c(0.02, 0.02)) +
    scale_y_continuous(limits = c(lower_limit, upper_limit),
                       expand = expansion(mult = c(0, 0))) +
    coord_cartesian(clip = "off") +
    labs(
      title = NULL,
      subtitle = NULL,
      x = "Calendar month",
      y = ylab,
      caption = "Shaded region indicates the rainy season"
    ) +
    theme_minimal(base_size = base_size) +
    theme(
      plot.title = element_text(size = base_size + 2, face = "bold"),
      plot.subtitle = element_text(size = base_size),
      axis.title = element_text(size = base_size),
      axis.text = element_text(size = base_size - 1),
      panel.grid.major = element_line(linetype = "dotted", color = "grey70"),
      panel.grid.minor = element_line(linetype = "dotted", color = "grey85"),
      plot.margin = grid::unit(c(10, 10, 18, 10), "pt")
    )
  
  list(data = season_df, plot = p)
}

season_res <- plot_seasonality_curve(
