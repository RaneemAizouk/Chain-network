###############################################################################
# Baseline acquisition incidence + decolonisation time
# Forest-plot style figure for slide use version 2, three panels
###############################################################################

library(tidyverse)
library(rstan)
library(patchwork)

#---------------------------------------------------------------------
# Helper: posterior summary
#---------------------------------------------------------------------
qsum <- function(x) {
  x <- as.numeric(x)
  x <- x[is.finite(x)]
  tibble(
    median = median(x, na.rm = TRUE),
    lo = quantile(x, 0.025, na.rm = TRUE),
    hi = quantile(x, 0.975, na.rm = TRUE)
  )
}

#---------------------------------------------------------------------
# Build draw-level baseline quantities
# - acquisition incidence is converted to per person-month
# - decolonisation is shown as mean days = 1 / lambda10
#---------------------------------------------------------------------
build_baseline_draws <- function(fit, site_names = NULL, days_per_month = 30.44) {
  draws <- rstan::extract(
    fit,
    pars = c("log_lambda01_comm", "log_lambda01_hosp", "log_lambda10_base", "u_site")
  )
  
  n_sites <- dim(draws$u_site)[2]
  if (is.null(site_names)) site_names <- paste0("Site ", seq_len(n_sites))
  if (length(site_names) != n_sites) {
    stop("site_names must have length equal to the number of sites in the fit")
  }
  
  overall <- tibble(
    site = "Overall",
    parameter = c(
      "Post-discharge acquisition",
      "Hospital acquisition",
      "Mean decolonisation time (days)"
    ),
    value = list(
      days_per_month * exp(draws$log_lambda01_comm),
      days_per_month * exp(draws$log_lambda01_hosp),
      1 / exp(draws$log_lambda10_base)
    )
  ) %>%
    unnest(value)
  
  site_specific <- map_dfr(seq_len(n_sites), function(s) {
    tibble(
      site = site_names[s],
      parameter = c(
        "Post-discharge acquisition",
        "Hospital acquisition",
        "Mean decolonisation time (days)"
      ),
      value = list(
        days_per_month * exp(draws$log_lambda01_comm + draws$u_site[, s]),
        days_per_month * exp(draws$log_lambda01_hosp + draws$u_site[, s]),
        1 / exp(draws$log_lambda10_base + draws$u_site[, s])
      )
    ) %>%
      unnest(value)
  })
  
  bind_rows(overall, site_specific)
}

#---------------------------------------------------------------------
# Summarise draw-level quantities
#---------------------------------------------------------------------
summarise_draws <- function(df) {
  df %>%
    group_by(site, parameter) %>%
    summarise(
      median = median(value, na.rm = TRUE),
      lo = quantile(value, 0.025, na.rm = TRUE),
      hi = quantile(value, 0.975, na.rm = TRUE),
      .groups = "drop"
    )
}

#---------------------------------------------------------------------
# Forest-plot panel for a single rate outcome
# - Use this to split hospital and post-discharge into separate panels
#---------------------------------------------------------------------
plot_rate_panel <- function(draw_df,
                            summ_df,
                            site_choice = "Overall",
                            parameter_choice,
                            title = NULL,
                            xlab = "Incidence per person-month",
                            fill_value = "#CB181D",
                            upper_cap = NULL) {
  df <- draw_df %>%
    filter(site == site_choice, parameter == parameter_choice)
  
  ann <- summ_df %>%
    filter(site == site_choice, parameter == parameter_choice) %>%
    mutate(
      label = if (parameter_choice == "Mean decolonisation time (days)") {
        sprintf("%.1f (%.1f–%.1f)", median, lo, hi)
      } else {
        sprintf("%.2f (%.2f–%.2f)", median, lo, hi)
      },
      x_pos = if (parameter_choice == "Mean decolonisation time (days)") {
        hi * 1.3
      } else {
        hi * 1.2
      }
    )
  
  if (is.null(upper_cap)) upper_cap <- max(df$value, na.rm = TRUE) * 1.25
  
  ggplot(df, aes(x = parameter, y = value)) +
    geom_boxplot(outlier.shape = NA, width = 0.62, linewidth = 0.4, fill = fill_value) +
    geom_text(
      data = ann,
      aes(x = parameter, y = x_pos, label = label),
      inherit.aes = FALSE,
      hjust = 0,
      size = 3.8
    ) +
    coord_flip(ylim = c(0, upper_cap), clip = "off") +
    scale_y_continuous(expand = expansion(mult = c(0.02, 0.15))) +
    labs(
      title = title,
      x = NULL,
      y = xlab
    ) +
    theme_minimal(base_size = 13) +
    theme(
      legend.position = "none",
      axis.text.y = element_blank(),
      axis.ticks.y = element_blank(),
      panel.grid.major = element_line(linetype = "dotted", color = "grey75"),
      panel.grid.minor = element_line(linetype = "dotted", color = "grey90"),
      plot.title = element_text(face = "bold", size = 14),
      plot.margin = margin(6, 24, 6, 6)
    )
}

