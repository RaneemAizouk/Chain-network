#---------------------------------------------------------------------
# Main wrapper: make slide-ready figures
#---------------------------------------------------------------------
make_baseline_decolonisation_figure <- function(fit,
                                                site_names = NULL,
                                                output_file = NULL,
                                                days_per_month = 30.44) {
  draw_df <- build_baseline_draws(fit, site_names = site_names, days_per_month = days_per_month)
  summ_df  <- summarise_draws(draw_df)
  
  # Overall panels
  overall_hosp <- plot_rate_panel(
    draw_df, summ_df,
    site_choice = "Overall",
    parameter_choice = "Hospital acquisition",
    title = "Overall hospital acquisition",
    xlab = "Incidence per person-month",
    fill_value = "#CB181D"
  )
  
  overall_post <- plot_rate_panel(
    draw_df, summ_df,
    site_choice = "Overall",
    parameter_choice = "Post-discharge acquisition",
    title = "Overall post-discharge acquisition",
    xlab = "Incidence per person-month",
    fill_value = "#595959"
  )
  
  overall_dec <- plot_rate_panel(
    draw_df, summ_df,
    site_choice = "Overall",
    parameter_choice = "Mean decolonisation time (days)",
    title = "Overall decolonisation time",
    xlab = "Days",
    fill_value = "#7F7F7F"
  )
  
  # Site-specific panels
  site_hosp <- plot_site_specific_rate(
    draw_df, summ_df,
    parameter_choice = "Hospital acquisition",
    site_order = site_names,
    title = "Site-specific hospital acquisition",
    xlab = "Incidence per person-month",
    fill_value = "#CB181D"
  )
  
  site_post <- plot_site_specific_rate(
    draw_df, summ_df,
    parameter_choice = "Post-discharge acquisition",
    site_order = site_names,
    title = "Site-specific post-discharge acquisition",
    xlab = "Incidence per person-month",
    fill_value = "#595959"
  )
  
  site_dec <- plot_site_specific_rate(
    draw_df, summ_df,
    parameter_choice = "Mean decolonisation time (days)",
    site_order = site_names,
    title = "Site-specific decolonisation time",
    xlab = "Days",
    fill_value = "#7F7F7F"
  )
  
  # Recommended slide layout:
  # Top row: hospital vs post-discharge
  # Bottom row: decolonisation time
  p_overall <- (overall_hosp | overall_post) / overall_dec +
    plot_layout(heights = c(1, 0.9))
  
  # Appendix / backup slide: site-specific version
  p_sites <- (site_hosp | site_post) / site_dec +
    plot_layout(heights = c(1.2, 1))
  
  if (!is.null(output_file)) {
    ggsave(
      filename = output_file,
      plot = p_sites,
      width = 12,
      height = 11,
      dpi = 300,
      bg = "white"
    )
  }
  
  list(
    draw_df = draw_df,
    summary_df = summ_df,
    p_overall = p_overall,
    p_sites = p_sites,
    overall_hosp = overall_hosp,
    overall_post = overall_post,
    overall_dec = overall_dec,
    site_hosp = site_hosp,
    site_post = site_post,
    site_dec = site_dec
  )
}

